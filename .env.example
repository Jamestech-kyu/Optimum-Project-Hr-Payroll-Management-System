# Django core
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret-key-at-least-50-characters
ALLOWED_HOSTS=api.example.com,example.com
TIME_ZONE=Africa/Nairobi

# Database
DB_NAME=hr_payroll_db
DB_USER=hrpayroll_user
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Frontend / browser security
CORS_ALLOWED_ORIGINS=https://example.com
CSRF_TRUSTED_ORIGINS=https://example.com
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=false

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Company information for generated documents
COMPANY_NAME=Optimum Computer Systems Ltd
COMPANY_ADDRESS=Nairobi, Kenya
COMPANY_EMAIL=info@optimumsystems.co.ke
COMPANY_PHONE=+254 118859686
